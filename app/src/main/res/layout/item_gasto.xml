<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/blanco"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/icono_categoria"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/fondo_icono"
            android:contentDescription="@string/descripcion_icono_categoria"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/texto_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 0dp con peso y una sola linea: sin esto, un nombre de categoria
                     largo ocupa toda la fila y empuja el pin fuera de la pantalla -->
                <TextView
                    android:id="@+id/texto_detalle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/gris_texto"
                    android:textSize="12sp" />

                <!-- solo se ve en los gastos que quedaron geoetiquetados -->
                <ImageView
                    android:id="@+id/icono_ubicacion"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/descripcion_gasto_con_ubicacion"
                    android:src="@drawable/ic_ubicacion"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/texto_monto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/texto_rojo"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- borrar tenia que ser visible: antes la unica forma era mantener
             pulsada la fila, que no lo indicaba nada -->
        <ImageView
            android:id="@+id/boton_borrar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/descripcion_borrar_gasto"
            android:padding="11dp"
            android:src="@drawable/ic_borrar" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
